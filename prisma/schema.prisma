// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================
enum UserRole {
  client
  admin
  guide
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum GuideStatus {
  local
  pro
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum BoostStatus {
  active
  expired
}

enum AvailabilityStatus {
  available
  unavailable
  blocked
}

enum DocumentType {
  CV
  diploma
  proof_of_residence
}

enum MediaType {
  photo
  video
  document
  audio
}

enum PaymentStatus {
  pending
  completed
  refunded
}

enum DisputeStatus {
  open
  pending
  resolved
  rejected
}

enum SubscriptionType {
  loco_plus
  standard
}

enum SupportTicketStatus {
  open
  in_progress
  closed
}

enum NotificationType {
  booking_reminder
  new_message
}

// ============================================
// MODELS
// USERS & ACCOUNTS (UTILISATEURS & COMPTES)
// ============================================

model user {
  id              String    @id @default(uuid()) @db.Uuid
  last_name       String    @db.VarChar(100)
  first_name      String    @db.VarChar(50)
  email           String    @unique @db.VarChar(100)
  password        String    @db.VarChar(255)
  role            UserRole
  refresh_token   String?   @db.Text
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  guides          guide[]
  bookings        booking[]
  opened_disputes dispute[]  @relation("DisputeUser")
  resolved_disputes dispute[]  @relation("DisputeAdmin")
  reviews         review[]
  subscriptions   subscription[]
  messages        message[]
  support_tickets support_ticket[]
  ticket_messages ticket_message[]
  notifications   notification[]
  
  @@map("user")
}

// ============================================
// GUIDES & DOCUMENTS
// ============================================

model guide {
  id                        String              @id @default(uuid()) @db.Uuid
  user_id                   String              @db.Uuid
  bio                       String?             @db.Text
  languages                 String?             @db.VarChar(100)
  years_of_experience       Int?
  guide_status              GuideStatus
  pro_card                  Boolean             @default(false)
  country                   String?             @db.VarChar(50)
  card_request_date         DateTime?           @db.Timestamp(6)
  card_verification_date    DateTime?           @db.Timestamp(6)
  internal_comment          String?             @db.Text
  created_at                DateTime            @default(now()) @db.Timestamp(6)
  updated_at                DateTime            @updatedAt @db.Timestamp(6)
  user                      user                @relation(fields: [user_id], references: [id])

  documents                 guide_document[]
  availabilities            guide_availability[]
  boosts                    guide_boost[]
  experiences               experience[]
  
  @@index([user_id])
  @@map("guide")
}

model guide_document {
  id                    String    @id @default(uuid()) @db.Uuid
  guide_id              String    @db.Uuid
  document_type         DocumentType
  verification_status   VerificationStatus
  verification_comment  String?   @db.Text
  upload_date           DateTime  @default(now()) @db.Timestamp(6)
  verification_date     DateTime? @db.Timestamp(6)
  
  guide                 guide     @relation(fields: [guide_id], references: [id])
  
  @@index([guide_id])
  @@map("guide_document")
}

model guide_availability {
  id          String    @id @default(uuid()) @db.Uuid
  guide_id    String    @db.Uuid
  start_date  DateTime  @db.Timestamp(6)
  end_date    DateTime  @db.Timestamp(6)
  status      AvailabilityStatus
  
  guide       guide     @relation(fields: [guide_id], references: [id], map: "guide_availability_guide_fkey")
  
  @@index([guide_id])
  @@map("guide_availability")
}

// ============================================
// BOOST & OFFERS (BOOST & OFFRES)
// ============================================

model boost_offer {
  id                      String        @id @default(uuid()) @db.Uuid
  name                    String        @db.VarChar(100)
  description             String?       @db.Text
  duration_days           Int
  discount_percentage     Int
  price                   Decimal       @db.Decimal(10, 2)

  guide_boosts            guide_boost[]
  
  @@map("boost_offer")
}

model guide_boost {
  id              String      @id @default(uuid()) @db.Uuid
  guide_id        String      @db.Uuid
  boost_offer_id  String      @db.Uuid
  purchase_date   DateTime    @default(now()) @db.Timestamp(6)
  expiration_date DateTime    @db.Timestamp(6)
  status          BoostStatus
  
  guide           guide       @relation(fields: [guide_id], references: [id])
  boost_offer     boost_offer @relation(fields: [boost_offer_id], references: [id])
  
  @@index([guide_id])
  @@index([boost_offer_id])
  @@map("guide_boost")
}

// ============================================
// CITIES & EXPERIENCES (VILLES & EXPÉRIENCES)
// ============================================

model city {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(100)
  country     String       @db.VarChar(50)
  description String?      @db.Text
  
  experiences experience[]
  
  @@map("city")
}

model experience {
  id              String                  @id @default(uuid()) @db.Uuid
  title           String                  @db.VarChar(150)
  description     String?                 @db.Text
  price           Decimal                 @db.Decimal(10, 2)
  duration        Int
  city_id         String                  @db.Uuid
  guide_id        String                  @db.Uuid
  max_capacity    Int?
  
  city            city                    @relation(fields: [city_id], references: [id])
  guide           guide                   @relation(fields: [guide_id], references: [id])
  bookings        booking[] // bookings
  reviews         review[]
  categories      experience_category[]
  currency_prices experience_price[]
  
  @@index([city_id])
  @@index([guide_id])
  @@map("experience")
}

model category {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String                  @db.VarChar(50)
  
  experiences experience_category[]
  
  @@map("category")
}

model experience_category {
  experience_id String     @db.Uuid
  category_id   String     @db.Uuid
  
  experience    experience @relation(fields: [experience_id], references: [id])
  category      category   @relation(fields: [category_id], references: [id])
  
  @@id([experience_id, category_id])
  @@index([experience_id])
  @@index([category_id])
  @@map("experience_category")
}

// ============================================
// BOOKINGS & PAYMENTS (RÉSERVATIONS & PAIEMENTS)
// ============================================

model booking {
  id                     String         @id @default(uuid()) @db.Uuid
  user_id                String         @db.Uuid
  experience_id          String         @db.Uuid
  booking_date           DateTime       @db.Timestamp(6)
  status                 BookingStatus
  number_of_participants Int
  total_price            Decimal        @db.Decimal(10, 2)
  
  user                   user    @relation(fields: [user_id], references: [id])
  experience             experience     @relation(fields: [experience_id], references: [id])
  payments               payment[]
  disputes               dispute[]
  conversations          conversation[]
  
  @@index([user_id])
  @@index([experience_id])
  @@map("booking")
}

model payment {
  id              String      @id @default(uuid()) @db.Uuid
  booking_id      String      @db.Uuid
  amount          Decimal     @db.Decimal(10, 2)
  payment_date    DateTime    @default(now()) @db.Timestamp(6)
  method          String      @db.VarChar(50)
  status          PaymentStatus
  stripe_id       String?     @db.VarChar(100)
  
  booking         booking @relation(fields: [booking_id], references: [id])
  
  @@index([booking_id])
  @@map("payment")
}

model dispute {
  id                String      @id @default(uuid()) @db.Uuid
  booking_id        String      @db.Uuid
  user_id           String      @db.Uuid
  reason            String      @db.Text
  status            DisputeStatus
  created_at        DateTime    @default(now()) @db.Timestamp(6)
  resolution_date   DateTime?   @db.Timestamp(6)
  admin_id          String?     @db.Uuid
  
  booking           booking @relation(fields: [booking_id], references: [id])
  user              user @relation("DisputeUser", fields: [user_id], references: [id])
  admin             user? @relation("DisputeAdmin", fields: [admin_id], references: [id])
  
  @@index([booking_id])
  @@index([user_id])
  @@index([admin_id])
  @@map("dispute")
}

// ============================================
// REVIEWS & SUBSCRIPTIONS (AVIS & ABONNEMENTS)
// ============================================

model review {
  id              String      @id @default(uuid()) @db.Uuid
  user_id         String      @db.Uuid
  experience_id   String      @db.Uuid
  rating          Int
  comment         String?     @db.Text
  review_date     DateTime    @default(now()) @db.Timestamp(6)
  
  user            user @relation(fields: [user_id], references: [id])
  experience      experience  @relation(fields: [experience_id], references: [id])
  
  @@index([user_id])
  @@index([experience_id])
  @@map("review")
}

model subscription { // subscription
  id                String      @id @default(uuid()) @db.Uuid
  user_id           String      @db.Uuid
  subscription_type SubscriptionType
  start_date        DateTime    @db.Timestamp(6)
  end_date          DateTime    @db.Timestamp(6)
  status            String      @db.VarChar(20)
  
  user              user @relation(fields: [user_id], references: [id])
  
  @@index([user_id])
  @@map("subscription")
}

// ============================================
// MESSAGING (MESSAGERIE)
// ============================================

model conversation {
  id              String      @id @default(uuid()) @db.Uuid
  booking_id      String      @db.Uuid // booking_id
  created_at      DateTime    @default(now()) @db.Timestamp(6)
  
  booking         booking @relation(fields: [booking_id], references: [id])
  messages        message[]
  
  @@index([booking_id])
  @@map("conversation")
}

model message {
  id                String        @id @default(uuid()) @db.Uuid
  conversation_id   String        @db.Uuid
  author_id         String        @db.Uuid
  content           String        @db.Text
  sent_at           DateTime      @default(now()) @db.Timestamp(6)
  
  conversation      conversation  @relation(fields: [conversation_id], references: [id])
  author            user   @relation(fields: [author_id], references: [id])
  
  @@index([conversation_id])
  @@index([author_id])
  @@map("message")
}

// ============================================
// MEDIA (MÉDIA)
// ============================================

model media {
  id            String    @id @default(uuid()) @db.Uuid
  entity_type   String    @db.VarChar(50) // "experience", "guide", "user", "booking"
  entity_id     String    @db.Uuid
  url           String    @db.VarChar(255)
  media_type    MediaType
  description   String?   @db.Text
  upload_date   DateTime  @default(now()) @db.Timestamp(6)
  
  @@index([entity_type, entity_id])
  @@map("media")
}

// ============================================
// SUPPORT
// ============================================

model support_ticket {
  id              String            @id @default(uuid()) @db.Uuid
  user_id         String            @db.Uuid
  subject         String            @db.VarChar(150)
  status          SupportTicketStatus
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  closed_at       DateTime?         @db.Timestamp(6)
  
  user     user       @relation(fields: [user_id], references: [id])
  messages        ticket_message[]
  
  @@index([user_id])
  @@map("support_ticket")
}

model ticket_message {
  id          String          @id @default(uuid()) @db.Uuid
  ticket_id   String          @db.Uuid
  author_id   String          @db.Uuid
  content     String          @db.Text
  sent_at     DateTime        @default(now()) @db.Timestamp(6)
  
  ticket      support_ticket  @relation(fields: [ticket_id], references: [id])
  author      user     @relation(fields: [author_id], references: [id])
  
  @@index([ticket_id])
  @@index([author_id])
  @@map("ticket_message")
}

// ============================================
// NOTIFICATIONS
// ============================================

model notification {
  id              String      @id @default(uuid()) @db.Uuid
  user_id         String      @db.Uuid
  type            NotificationType
  content         String      @db.Text
  read            Boolean     @default(false)
  sent_at         DateTime    @default(now()) @db.Timestamp(6)
  
  user     user @relation(fields: [user_id], references: [id])
  
  @@index([user_id])
  @@map("notification")
}

// ============================================
// CURRENCIES & PRICING (DEVISES & TARIFICATION)
// ============================================

model currency {
  code            String            @id @db.Char(3) // "EUR", "USD"
  name            String            @db.VarChar(50)
  exchange_rate   Decimal           @db.Decimal(10, 4)
  
  prices          experience_price[]
  
  @@map("currency")
}

model experience_price { // experience_price
  experience_id String     @db.Uuid
  currency_code String     @db.Char(3)
  price         Decimal    @db.Decimal(10, 2)
  
  experience    experience @relation(fields: [experience_id], references: [id])
  currency      currency   @relation(fields: [currency_code], references: [code])
  
  @@id([experience_id, currency_code])
  @@index([experience_id])
  @@index([currency_code])
  @@map("experience_price")
}
