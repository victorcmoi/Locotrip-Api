# Configuration de l'API
API_PORT=3000
NODE_ENV=development

# Base de données Prisma
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=VOTRE_API_KEY"

# JWT
JWT_SECRET=dev_secret_key_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=dev_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# Prisma Studio (optionnel)
PRISMA_STUDIO_PORT=5555

# Mailgun Configuration
# Prod
# MAILGUN_API_KEY="api_key_production"
# MAILGUN_DOMAIN="loco-trip.com"
MAILGUN_BASE_URL="https://api.eu.mailgun.net"

# Dev
MAILGUN_API_KEY_SANDBOX="api_key_sandbox"
MAILGUN_SANDBOX_DOMAIN="api_sandbox_domain"
MAILGUN_BASE_URL_SANDBOX="https://api.mailgun.net"
FROM_EMAIL="noreply@loco-trip.com"
FRONTEND_URL="https://loco-trip.com"

# Stripe
STRIPE_PUBLIC_KEY="stripe_public_key"
STRIPE_PRIVATE_KEY="stripe_private_key"

# Minio
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_ROOT_USER="minio"
MINIO_ROOT_PASSWORD="mot_de_passe"
MINIO_BROWSER_REDIRECT_URL="http://localhost:9001"
MINIO_SERVER_URL="http://localhost:9000"